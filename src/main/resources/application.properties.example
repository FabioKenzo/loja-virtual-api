# ===================================================================
# ARQUIVO DE EXEMPLO - LOJA VIRTUAL API
# Renomeie este arquivo para 'application.properties' e preencha os valores.
# ===================================================================

# Configurações do Banco de Dados
# Se estiver usando Docker, o host deve ser o nome do serviço (ex: mysql-loja)
spring.datasource.url=jdbc:mysql://${DB_HOST:localhost}:3306/loja_virtual?useSSL=false&serverTimezone=UTC
spring.datasource.username=seu_usuario_aqui
spring.datasource.password=sua_senha_aqui

# Configurações do Hibernate/JPA
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect

# Porta da Aplicação
server.port=8080

# Documentação Swagger disponível em: /swagger-ui.html